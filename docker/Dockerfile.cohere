FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/app/.enuv
ENV PATH="/app/.enuv/bin:${PATH}"
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ffmpeg libsndfile1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN python3 -m venv /app/.enuv \
    && /app/.enuv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /app/.enuv/bin/python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu124 \
    && /app/.enuv/bin/python -m pip install --no-cache-dir -r /app/requirements.txt

COPY app /app/app

EXPOSE 9000

CMD ["/app/.enuv/bin/python", "-m", "uvicorn", "app.cohere_server:app", "--host", "0.0.0.0", "--port", "9000"]
